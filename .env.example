# Your own WhatsApp number, e.g. 919876543210@s.whatsapp.net. Required from
# the first run.
WHATSAPP_ADMIN_JID=

# The group's WhatsApp JID, e.g. 1234567890-1234567890@g.us. Leave this
# empty for the very first run — it can't be known until the bot has
# connected once and seen a message from the group. Start the bot, scan the
# QR code, add the bot number to the group, send any message there, and
# read the JID off the "Incoming message" log line. Then fill this in and
# restart. Until it's set, the bot connects and responds to DMs fine, but
# skips every menu-post/rating-prompt job (logged as a warning each time).
WHATSAPP_GROUP_JID=

DEEPSEEK_API_KEY=
DB_PATH=menubot.db
MENU_PATH=menu.yaml
CONFIG_PATH=config.yaml
AUTH_DIR=auth
