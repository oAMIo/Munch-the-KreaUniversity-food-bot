[Unit]
Description=Plato - Krea mess menu WhatsApp bot
After=network-online.target
Wants=network-online.target
# A dead WhatsApp session makes the bot exit; don't hammer WhatsApp with
# restarts. If this trips, check `journalctl -u plato`.
StartLimitIntervalSec=600
StartLimitBurst=6

[Service]
User=apps
Group=apps
WorkingDirectory=/srv/plato
EnvironmentFile=/etc/plato/env
Environment=PATH=/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /srv/plato/dist/bot.js
Restart=on-failure
RestartSec=10
# DB + WhatsApp session live here (/var/lib/plato)
StateDirectory=plato
StateDirectoryMode=0700

MemoryHigh=384M
MemoryMax=512M
TasksMax=128

# Hardening: /srv/plato is read-only to the running app; no view of /home
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
