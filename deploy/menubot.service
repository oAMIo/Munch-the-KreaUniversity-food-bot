[Unit]
Description=Mess Menu WhatsApp Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=romulus
WorkingDirectory=/home/romulus/Munch-the-KreaUniversity-food-bot
EnvironmentFile=/home/romulus/Munch-the-KreaUniversity-food-bot/.env
ExecStart=/home/romulus/.nvm/versions/node/v24.16.0/bin/node /home/romulus/Munch-the-KreaUniversity-food-bot/dist/bot.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
